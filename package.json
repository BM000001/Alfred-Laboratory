{
  "name": "alfred",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "node scripts/copy-ocr-assets.mjs && tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:pages": "node scripts/copy-ocr-assets.mjs && tsc -b && vite build --mode github-pages && cp manifest.webmanifest apple-touch-icon-180.png icon-192.png icon-512.png icon-maskable-512.png dist/",
    "predev": "node scripts/copy-ocr-assets.mjs"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "pdfjs-dist": "6.5.438",
    "tesseract.js": "7.0.0",
    "@tesseract.js-data/por": "1.0.0",
    "tesseract.js-core": "7.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.4",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.6.0",
    "fake-indexeddb": "^6.2.4",
    "jsdom": "^26.1.0",
    "typescript": "~5.8.3",
    "vite": "^6.4.5",
    "vitest": "^5.1.0"
  }
}
